datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique // Prevents duplicate accounts
  password  String   // Hashed password string
  role      Role     @default(ADMIN) // Useful for controlling CMS access
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PostImage {
  id        String   @id @default(cuid())
  url       String
  key       String?

  // Main Image Relation
  mainForProjects Project[] @relation("MainImage")

  // Gallery Images Relation (1-to-Many with Project)
  projectId String?
  project   Project? @relation("GalleryImages", fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model PostVideo {
  id        String   @id @default(cuid())
  url       String
  key       String?  // Useful if managing uploads with UploadThing

  // One-to-one relation pointing back to Project
  projectId String   @unique // @unique constraint ensures only ONE video per project
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String

  // Main Cover Image (Foreign key stored in Project)
  mainImageId String?
  mainImage   PostImage? @relation("MainImage", fields: [mainImageId], references: [id], onDelete: SetNull)

  // Single Video (1-to-1)
  video       PostVideo?

  // Gallery Images (1-to-Many where foreign key is in PostImage)
  images      PostImage[] @relation("GalleryImages")

  categories  Category[]

  order       Int      @default(0)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model Category {
  id       String    @id @default(cuid())
  title    String    @unique
  slug     String    @unique
  projects Project[]
}